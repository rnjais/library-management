# ==============================================================================
# Environment Configuration Template for Docker Compose
# Copy this file to '.env' and update values before running 'docker compose up'
# ==============================================================================

# Application Port
APP_PORT=8080

# Local Spring Boot Database Credentials (loaded via spring.config.import)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=library_db
DB_TEST_NAME=library_test_db
DB_USERNAME=root
DB_PASSWORD=change_this_local_db_password

# MySQL 8.0 Docker Compose Database Configuration
MYSQL_PORT=3306
MYSQL_DATABASE=library_management_db
MYSQL_USER=library_user
MYSQL_PASSWORD=change_this_in_production_password
MYSQL_ROOT_PASSWORD=change_this_in_production_root_password

# JWT Security
# Generate a secure >= 256-bit Base64-encoded secret (e.g. `openssl rand -base64 48`)
JWT_SECRET_KEY=replace_with_base64_encoded_256bit_secret_key
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Dispatch Configuration
APP_MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
APP_MAIL_FROM=noreply@librarymanagement.com
