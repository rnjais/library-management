# ==============================================================================
# Environment Configuration Template for Docker Compose
# Copy this file to '.env' and update values before running 'docker compose up'
# ==============================================================================

# Application Port
APP_PORT=8080

# MySQL 8.0 Database Configuration
MYSQL_PORT=3306
MYSQL_DATABASE=library_management_db
MYSQL_USER=library_user
MYSQL_PASSWORD=change_this_in_production_password
MYSQL_ROOT_PASSWORD=change_this_in_production_root_password

# JWT Security
# Generate a secure 256-bit Base64-encoded secret for production
JWT_SECRET_KEY=dGhpcy1pcy1hLXNhZmUtZGV2ZWxvcG1lbnQtdGVzdC1qd3Qtc2VjcmV0LWtleS0yNTYtYml0cw==
JWT_EXPIRATION_MS=86400000

# Email Dispatch Configuration
APP_MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
APP_MAIL_FROM=noreply@librarymanagement.com
